XPPCBK VERSION 001.000.010
// sample callback script
CALLBACK WNDPROC MyWndProc
CALLBACK ENUMWINDOWSPROC MyEnum // comment
BEGIN CALLBACK MyCmp RETURNS DWORD
  PARAM DWORD
  PARAM DOUBLE
  PARAM BOOL
END CALLBACK
USING CDECL
BEGIN CALLBACK MyVoid RETURNS VOID
END CALLBACK
BEGIN CALLBACK MyQ RETURNS QWORD
  PARAM QWORD
  PARAM FLOAT
  PARAM WORD
  PARAM BYTE
END CALLBACK
__CDECL x
BEGIN CALLBACK MyDbl AS DOUBLE
  PARAM LPSTR
END CALLBACK
